{
  "name": "fourfold",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "start": "pnpm --filter @fourfold/api start",
    "dev:web": "pnpm --filter @fourfold/web dev",
    "build": "pnpm --filter @fourfold/web build && pnpm --filter @fourfold/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@fourfold/core": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
